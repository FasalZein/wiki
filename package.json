{
  "name": "wiki",
  "version": "0.1.0",
  "description": "Workspace root for the wiki CLI (packages/wiki) and its Node packages, plus local mutation tooling.",
  "type": "module",
  "scripts": {
    "mutation:file": "node scripts/mutation-file.mjs",
    "test:tooling": "node --test scripts/test/*.test.mjs",
    "typecheck:tooling": "tsc -p scripts/tsconfig.json",
    "typecheck:wiki": "tsc -p packages/wiki/tsconfig.json",
    "test:wiki": "node packages/wiki/test/run.js",
    "verify:wiki": "bun run typecheck:wiki && bun run test:wiki",
    "boot:wiki": "node packages/wiki/scripts/boot.js",
    "verify:next": "tsc -p packages/tsconfig.json && node --test \"packages/*/test/*.test.ts\""
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@types/node": "26.6.6",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "11.0.5",
      "typed-rest-client": {
        "qs": "6.17.1"
      }
    }
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
