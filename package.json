{
  "name": "wiki",
  "version": "0.1.0",
  "description": "Config-driven artifact store and semantic recall tool over a plain-Markdown vault. The CLI is the only writer.",
  "type": "module",
  "bin": {
    "wiki": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts",
    "mutation:file": "node scripts/mutation-file.mjs",
    "test:tooling": "node --test scripts/test/*.test.mjs",
    "typecheck:tooling": "tsc -p scripts/tsconfig.json",
    "build": "bun build src/cli.ts --outdir dist --target bun && rm -rf dist/templates && cp -R templates dist/templates",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "typecheck:okf": "tsc -p packages/okf-wiki/tsconfig.json",
    "test:okf": "node packages/okf-wiki/test/run.js",
    "verify:okf": "bun run typecheck:okf && bun run test:okf",
    "verify:next": "tsc -p packages/tsconfig.json && node --test \"packages/*/test/*.test.ts\""
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "11.0.5",
      "typed-rest-client": { "qs": "6.17.1" }
    }
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
