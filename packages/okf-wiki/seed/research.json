{
  "name": "research",
  "folder": "research",
  "frontmatterSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "type": {
        "const": "research"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "status": {
        "enum": [
          "draft",
          "stable",
          "deprecated"
        ]
      },
      "created": {
        "type": "string",
        "format": "date-time",
        "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "stale_after": {
        "type": "string",
        "format": "date-time",
        "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "superseded_by": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "type",
      "title",
      "description",
      "created"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "required": [
            "superseded_by"
          ]
        },
        "then": {
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "deprecated"
            }
          }
        }
      }
    ]
  },
  "requiredHeadings": [
    {
      "level": 2,
      "text": "Findings"
    },
    {
      "level": 2,
      "text": "Sources"
    }
  ],
  "template": "## Findings\n\n## Sources\n"
}
