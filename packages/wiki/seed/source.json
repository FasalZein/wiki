{
  "name": "source",
  "folder": "references",
  "frontmatterSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "type": {
        "const": "source"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "status": {
        "enum": [
          "draft",
          "stable",
          "deprecated"
        ]
      },
      "created": {
        "type": "string",
        "format": "date-time",
        "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "stale_after": {
        "type": "string",
        "format": "date-time",
        "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "superseded_by": {
        "type": "string",
        "minLength": 1
      },
      "resource": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
      },
      "retrieved": {
        "type": "string",
        "format": "date-time",
        "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "original": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
      },
      "original_sha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "extracted": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
      },
      "extracted_sha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "extractor": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
      },
      "extractor_version": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
      },
      "media_type": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
      },
      "final_resource": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "type",
      "title",
      "description",
      "created",
      "resource",
      "retrieved",
      "original",
      "original_sha256",
      "extracted",
      "extracted_sha256",
      "extractor",
      "extractor_version",
      "media_type"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "required": [
            "superseded_by"
          ]
        },
        "then": {
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "deprecated"
            }
          }
        }
      }
    ]
  },
  "requiredHeadings": [
    {
      "level": 2,
      "text": "Extracted Text"
    }
  ],
  "template": "## Extracted Text\n"
}
